<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<!-- Pantalla de navegación general de GAME VAULT:
     ToolBar (arriba), Pagination (centro) e Hyperlink (abajo). -->
<BorderPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="navegacion.NavegacionController">
   <top>
      <ToolBar fx:id="barraNavegacion" prefHeight="40.0" BorderPane.alignment="CENTER">
         <items>
            <Label text="🎮 GAME VAULT" />
            <Separator orientation="VERTICAL" />
            <Button fx:id="btnInicio" mnemonicParsing="false" onAction="#onInicio" text="Inicio" />
            <Button fx:id="btnBiblioteca" mnemonicParsing="false" onAction="#onBiblioteca" text="Biblioteca" />
            <Button fx:id="btnAnadir" mnemonicParsing="false" onAction="#onAnadir" text="Añadir" />
            <Button fx:id="btnPerfil" mnemonicParsing="false" onAction="#onPerfil" text="Perfil" />
         </items>
      </ToolBar>
   </top>
   <center>
      <Pagination fx:id="paginacion" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </BorderPane.margin>
      </Pagination>
   </center>
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <Hyperlink fx:id="enlaceInfo" onAction="#onEnlaceInfo" text="🌐 Más información sobre el videojuego" />
            <Label fx:id="lblEstado" text="Sección: Inicio" />
         </children>
         <padding>
            <Insets bottom="10.0" left="15.0" right="15.0" top="5.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
